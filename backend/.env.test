NODE_ENV=test
DATABASE_URL=jdbc:postgresql://127.0.0.1:5432/civictrack_test
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
PG_POOL_MAX=5

JWT_SECRET=test_jwt_secret_do_not_use_in_production
JWT_ACCESS_EXPIRE=15m
JWT_REFRESH_EXPIRE_DAYS=30

CLIENT_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_MAX_REQUESTS=100000
RATE_LIMIT_WINDOW_MS=900000

# Left blank on purpose — notificationService.sendEmail() degrades to
# returning false (logged, not thrown) when these are unset, which is
# fine for tests that don't specifically exercise email delivery.
EMAIL_SERVICE=
EMAIL_USERNAME=
EMAIL_PASSWORD=


#                     ┌─────────────┐
#                     │   MongoDB   │
#                     │ video metadata
#                     └─────────────┘
#                            ▲
#                            │
# Browser ──► Express ───────┘
#     │          │
#     │          │ presigned URL
#     │          ▼
#     └──────► AWS S3
#              actual video