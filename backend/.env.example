# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=5000
CLIENT_URL=http://localhost:3000

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL — primary datastore (users, reports, tenures, notifications)
# DATABASE_URL holds host/port/database only (no credentials) — this
# matches Supabase's pooler-style JDBC connection string.
DATABASE_URL=jdbc:postgresql://aws-1-ap-south-1.pooler.supabase.com:5432/postgres
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SSL=true
PG_POOL_MAX=10

# MongoDB — kept ONLY for GridFS video storage (files > 10MB)
MONGODB_URI=your_mongodb_atlas_connection_string_here
DB_NAME=civictrack

# ============================================
# REDIS / QUEUE CONFIGURATION
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=generate_random_secret_here
# Access token: short-lived, stateless, never stored in the DB.
JWT_ACCESS_EXPIRE=15m
# Refresh token: long-lived, opaque, stored (as a hash) in the
# refresh_tokens table so it can be revoked on logout/rotation.
JWT_REFRESH_EXPIRE_DAYS=30

# ============================================
# CLOUDINARY CONFIGURATION
# ============================================
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ============================================
# EMAIL CONFIGURATION
# ============================================
EMAIL_SERVICE=gmail
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
EMAIL_FROM=noreply@civictrack.com

# ============================================
# FILE UPLOAD LIMITS
# ============================================
MAX_IMAGE_SIZE=5242880
MAX_VIDEO_SIZE=104857600
MAX_GRIDFS_VIDEO_SIZE=524288000

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# CORS CONFIGURATION
# ============================================
ALLOWED_ORIGINS=http://localhost:3000,https://civictrack.com

# ============================================
# GEOSPATIAL CONFIGURATION
# ============================================
DEFAULT_SEARCH_RADIUS=5000
MAX_SEARCH_RADIUS=50000

# ============================================
# OPENROUTER (LLM PROVIDER FOR AI CATEGORIZATION)
# ============================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

